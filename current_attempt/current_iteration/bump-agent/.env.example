# Copy to .env (gitignored). Required for the dashboard feedback form.
BJV_DASH_TOKEN=change-me

# Image. Default: pull vasiliymikhailov/bjv-agent:latest, else build ./Dockerfile
# BJV_IMAGE=vasiliymikhailov/bjv-agent:latest

# Supervisor / bump agent — only needed with: docker compose --profile supervisor up
OC_KEY=
OC_BASE=https://inference.mikhailov.tech/qwen-3.6-35b-a3b-awq/v1
OC_MODEL=qwen-3.6-35b-a3b-awq
BJV_SUPERVISOR_MINUTES=20
