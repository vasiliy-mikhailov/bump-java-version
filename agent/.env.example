# Copy to .env (gitignored). Paths are HOST paths: nested `docker run -v` sees the daemon's filesystem.

# Required
BJV_DASH_TOKEN=change-me
BJV_IMAGE=registry.example.com/bjv-agent:latest
BJV_JDK_IMAGE=registry.example.com/bjv-alljdk:latest
BJV_RUNROOT=/var/lib/bjv
BJV_HOPTOOLS=/var/lib/bjv/hoptools
BJV_MANIFEST=/var/lib/bjv/manifest.tsv
GIT_BASE=https://gitlab.example.com

# Where dependencies resolve from. Maven reads it out of settings.xml below; Gradle cannot read a
# Maven settings file, so it has to be named here too.
BJV_REPO_URL=https://nexus.example.com/repository/maven-public/

# LLM (OpenAI-compatible, tool-calling required)
OC_BASE=https://llm.example.com/v1
OC_KEY=
OC_MODEL=your-model-name
# false if the endpoint is not Qwen and rejects chat_template_kwargs.enable_thinking
BJV_THINKING=true

# Git auth: HTTPS token OR path to an SSH key (mount the key at the same host path)
# GIT_TOKEN=
# GIT_SSH_KEY=/var/lib/bjv/git_id_ed25519

# Maven / Gradle on the host, mounted same-path into the agent then into bjv-alljdk
BJV_NET=mvn-cache
BJV_M2=/var/lib/bjv/m2
BJV_SETTINGS=/var/lib/bjv/maven-config/settings.xml
BJV_GRADLE_RO=/var/lib/bjv/gradle-cache
BJV_GRADLE_DISTS=/var/lib/bjv/gradle-dists
BJV_GRADLE_INIT=/var/lib/bjv/maven-config/init.gradle

# Optional CWE scan image (defaults to bjv-alljdk:trivy; leave unset to skip a dedicated tag)
# BJV_SCAN_IMAGE=registry.example.com/bjv-alljdk:trivy
