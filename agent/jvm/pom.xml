<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>tech.mikhailov.bjv</groupId>
    <artifactId>bump-agent-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>bump-agent-jvm</artifactId>
  <packaging>jar</packaging>
  <!-- WHAT A JVM PROJECT IS, with no opinion about which bump you are doing. Reading the module
       tree, running a build under a chosen JDK, measuring bytecode majors, staging a gradle
       distribution, reading a jar. It depends on engine for the trace and the tool plumbing, and
       on nothing else here, so a different pipeline can take engine and jvm and leave the rest. -->
  <dependencies>
    <dependency>
      <groupId>tech.mikhailov.bjv</groupId>
      <artifactId>bump-agent-engine</artifactId>
    </dependency>
    <!-- Declared rather than inherited from engine, because this module's tools name
         ToolSpecification, ToolExecutor and JsonObjectSchema in their own signatures. It compiled
         on engine's transitive for as long as engine happened to have one. -->
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
    </dependency>
  </dependencies>
</project>
