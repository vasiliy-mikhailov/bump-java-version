<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>tech.mikhailov.bjv</groupId>
    <artifactId>bump-agent-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>bump-agent-engine</artifactId>
  <packaging>jar</packaging>
  <!-- THE BOTTOM LAYER, AND IT KNOWS NOTHING ABOUT JAVA VERSIONS. Model wiring, the streaming
       reply, the thinking budget, the agent flow, the trace and the JSONL record it is written as.
       Nothing here mentions a pom, a JDK or a bump, which is the whole point: this module has no
       dependency on any other module here and can be consumed on its own. -->
  <!-- THREE ARTIFACTS WHERE THERE USED TO BE ONE PLUS A WRAPPER. langchain4j carries AiServices
       and the tool loop the agents run on, langchain4j-open-ai carries the streaming model this
       endpoint speaks to, and the JDK http client is what both of them are pointed at. Two of the
       three were already being used here and were arriving through somebody else's dependency,
       which is the compile that breaks when that somebody stops needing them. -->
  <dependencies>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-open-ai</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.langchain4j</groupId>
      <artifactId>langchain4j-http-client-jdk</artifactId>
    </dependency>
  </dependencies>
</project>
